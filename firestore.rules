rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esElDueno() {
      return request.auth != null && resource.data.usuarioId == request.auth.uid;
    }

    function creandoComoDueno() {
      return request.auth != null && request.resource.data.usuarioId == request.auth.uid;
    }

    function noCambiaDueno() {
      return request.resource.data.usuarioId == resource.data.usuarioId;
    }

    match /usuarios/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /historialPeso/{id} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /programas/{id} {
      allow read, delete: if esElDueno();
      allow update: if esElDueno() && noCambiaDueno();
      allow create: if creandoComoDueno()
        && request.resource.data.keys().hasOnly(['usuarioId', 'nombre', 'orden']);
    }

    match /dias/{id} {
      allow read, delete: if esElDueno();
      allow update: if esElDueno() && noCambiaDueno();
      allow create: if creandoComoDueno()
        && request.resource.data.keys().hasOnly(['usuarioId', 'programaId', 'nombre', 'orden']);
    }

    match /ejerciciosDia/{id} {
      allow read, delete: if esElDueno();
      allow update: if esElDueno() && noCambiaDueno();
      allow create: if creandoComoDueno()
        && request.resource.data.keys().hasOnly(['usuarioId', 'diaId', 'nombre', 'grupoMuscular', 'esCustom', 'seriesEsperadas', 'repsEsperadas', 'orden']);
    }

    match /sesiones/{id} {
      allow read, delete: if esElDueno();
      allow update: if esElDueno() && noCambiaDueno();
      allow create: if creandoComoDueno()
        && request.resource.data.keys().hasOnly(['usuarioId', 'diaId', 'fecha', 'nota', 'completada']);
    }

    match /registros/{id} {
      allow read, delete: if esElDueno();
      allow update: if esElDueno() && noCambiaDueno();
      allow create: if creandoComoDueno()
        && request.resource.data.keys().hasOnly(['usuarioId', 'sesionId', 'ejercicioId', 'nombreEjercicio', 'grupoMuscular', 'numeroSerie', 'repsEsperadas', 'repsHechas', 'pesoUsado', 'nota']);
    }

    match /ejerciciosCatalogo/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
