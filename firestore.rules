rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /usuarios/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /historialPeso/{id} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /programas/{id} {
      allow read, write: if request.auth != null && resource.data.usuarioId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.usuarioId == request.auth.uid;
    }

    match /sesiones/{id} {
      allow read, write: if request.auth != null && resource.data.usuarioId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.usuarioId == request.auth.uid;
    }

    match /dias/{id} {
      allow read, write: if request.auth != null;
    }

    match /ejerciciosDia/{id} {
      allow read, write: if request.auth != null;
    }

    match /registros/{id} {
      allow read, write: if request.auth != null;
    }

    match /ejerciciosCatalogo/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
