rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esElDueno() {
      return request.auth != null && resource.data.usuarioId == request.auth.uid;
    }

    function creandoComoDueno() {
      return request.auth != null && request.resource.data.usuarioId == request.auth.uid;
    }

    function noCambiaDueno() {
      return request.resource.data.usuarioId == resource.data.usuarioId;
    }

    // Solo los campos tocados por el update deben estar en la lista.
    // (diff sobre el doc previo: no rompe docs con campos legacy.)
    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // Un campo puntual fue tocado por este update (valor distinto al doc previo).
    function campoTocado(campo) {
      return campo in request.resource.data.diff(resource.data).affectedKeys();
    }

    // La FK apunta a un doc que existe y es del mismo usuario. Cuesta 1
    // lectura por llamada, así que solo se usa en los create poco
    // frecuentes (ver la nota sobre `registros` más abajo).
    function fkPropia(coleccion, id) {
      return exists(/databases/$(database)/documents/$(coleccion)/$(id))
        && get(/databases/$(database)/documents/$(coleccion)/$(id)).data.usuarioId == request.auth.uid;
    }

    // Forma de sesiones/{id}.resumen (ver buildResumen() en ResumenSesion.jsx).
    // Solo valida la cáscara: tipos + topes de tamaño generosos frente al uso
    // real (no hay forma de iterar los items de `ejercicios`/`series` en
    // rules, así que la forma interna de cada ejercicio/serie no se valida).
    function resumenValido(r) {
      return r is map
        && r.volumenTotal is number && r.volumenTotal >= 0
        && r.diaNombre is string && r.diaNombre.size() <= 300
        && r.ejercicios is list && r.ejercicios.size() <= 100;
    }

    match /usuarios/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['nombre', 'email', 'photoURL']);
      allow update: if request.auth != null && request.auth.uid == userId
        && soloCambia(['nombre', 'email', 'photoURL']);

      match /historialPeso/{id} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['peso', 'fecha'])
          && request.resource.data.peso is number
          && request.resource.data.peso >= 20
          && request.resource.data.peso <= 300;
      }

      match /stats/{statDoc} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;

        // ultimaSesionId/actualizadoEn: agregados por agregarSesionAResumenGlobalBlind
        // (statsGlobal.js), corre en cada sesión completada. actualizadoEn requiere
        // campoTocado() porque `== request.time` solo es cierto en el write que lo fija;
        // sin el guard, un update posterior que no lo toque (ej.
        // aplicarSesionAResumenGlobal) fallaría al comparar el timestamp preservado
        // contra el request.time actual.
        allow create: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['diasEntrenados', 'volumenPorSesion', 'ultimaSesionId', 'actualizadoEn'])
          && (!('ultimaSesionId' in request.resource.data) || request.resource.data.ultimaSesionId is string)
          && (!('actualizadoEn' in request.resource.data) || request.resource.data.actualizadoEn == request.time);

        allow update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['diasEntrenados', 'volumenPorSesion', 'ultimaSesionId', 'actualizadoEn'])
          && (!('ultimaSesionId' in request.resource.data) || request.resource.data.ultimaSesionId is string)
          && (!campoTocado('actualizadoEn') || request.resource.data.actualizadoEn == request.time);
      }

      match /statsEjercicios/{ejercicioId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        // aplicarSesionAStats/rebuildStatsEjercicios/getStatsEjerciciosConFallback
        // siempre hacen set() SIN merge (doc completo reescrito por el cliente),
        // así que puntos llega siempre como el array final ya cappeado a
        // MAX_PUNTOS=150 (statsEjercicios.js) -- seguro de validar sin condicional.
        allow create, update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['nombre', 'grupoMuscular', 'catalogoId', 'pr', 'ultimaVez', 'puntos'])
          && request.resource.data.puntos is list
          && request.resource.data.puntos.size() <= 150;
      }

      match /timerPresets/{presetId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['nombre', 'calentamiento', 'trabajo', 'descanso', 'sets', 'enfriamiento', 'creadoEn']);
      }
    }

    match /programas/{id} {
      allow read, delete: if esElDueno();
      allow update: if esElDueno() && noCambiaDueno()
        && soloCambia(['nombre', 'orden', 'eliminadoEn']);
      allow create: if creandoComoDueno()
        && request.resource.data.keys().hasOnly(['usuarioId', 'nombre', 'orden'])
        && request.resource.data.keys().hasAll(['usuarioId', 'nombre', 'orden']);
    }

    match /dias/{id} {
      allow read, delete: if esElDueno();
      allow update: if esElDueno() && noCambiaDueno()
        && soloCambia(['nombre', 'orden', 'eliminadoEn']);
      allow create: if creandoComoDueno()
        && request.resource.data.keys().hasOnly(['usuarioId', 'programaId', 'nombre', 'orden'])
        && request.resource.data.keys().hasAll(['usuarioId', 'programaId', 'nombre', 'orden'])
        && fkPropia('programas', request.resource.data.programaId);
    }

    match /ejerciciosDia/{id} {
      allow read, delete: if esElDueno();
      allow update: if esElDueno() && noCambiaDueno()
        && soloCambia(['nombre', 'seriesEsperadas', 'repsEsperadas', 'orden', 'eliminadoEn']);
      allow create: if creandoComoDueno()
        && request.resource.data.keys().hasOnly(['usuarioId', 'diaId', 'nombre', 'grupoMuscular', 'esCustom', 'catalogoId', 'seriesEsperadas', 'repsEsperadas', 'orden'])
        && request.resource.data.keys().hasAll(['usuarioId', 'diaId', 'nombre', 'grupoMuscular', 'esCustom', 'catalogoId', 'seriesEsperadas', 'repsEsperadas', 'orden'])
        && fkPropia('dias', request.resource.data.diaId);
    }

    match /sesiones/{id} {
      allow read, delete: if esElDueno();
      allow update: if esElDueno() && noCambiaDueno()
        && soloCambia(['nota', 'completada', 'resumen'])
        && (!campoTocado('resumen') || resumenValido(request.resource.data.resumen));
      allow create: if creandoComoDueno()
        && request.resource.data.keys().hasOnly(['usuarioId', 'diaId', 'fecha', 'nota', 'completada'])
        && request.resource.data.keys().hasAll(['usuarioId', 'diaId', 'fecha', 'nota', 'completada'])
        && fkPropia('dias', request.resource.data.diaId);
    }

    match /registros/{id} {
      allow read, delete: if esElDueno();
      allow update: if esElDueno() && noCambiaDueno()
        && soloCambia(['pesoUsado', 'repsHechas', 'nota'])
        && (!campoTocado('pesoUsado') || (request.resource.data.pesoUsado is number && request.resource.data.pesoUsado >= 0 && request.resource.data.pesoUsado <= 1000))
        && (!campoTocado('repsHechas') || (request.resource.data.repsHechas is number && request.resource.data.repsHechas >= 0 && request.resource.data.repsHechas <= 1000))
        && (!campoTocado('nota') || (request.resource.data.nota is string && request.resource.data.nota.size() <= 500));
      // Sin fkPropia() a proposito: este create corre una vez por SERIE
      // (~24 por sesion), y validar sesionId + ejercicioId costaria 2
      // lecturas extra cada vez -- el camino de escritura mas caliente de la
      // app, contra la regla de cuota de CLAUDE.md. La FK sin validar solo
      // permite ensuciar el propio arbol (ninguna regla de read ni query
      // deja ver datos ajenos), asi que no justifica ese costo.
      allow create: if creandoComoDueno()
        && request.resource.data.keys().hasOnly(['usuarioId', 'sesionId', 'ejercicioId', 'nombreEjercicio', 'grupoMuscular', 'catalogoId', 'numeroSerie', 'repsEsperadas', 'repsHechas', 'pesoUsado', 'nota'])
        && request.resource.data.keys().hasAll(['usuarioId', 'sesionId', 'ejercicioId', 'nombreEjercicio', 'grupoMuscular', 'catalogoId', 'numeroSerie', 'repsEsperadas', 'repsHechas', 'pesoUsado', 'nota'])
        && request.resource.data.numeroSerie is number && request.resource.data.numeroSerie >= 1 && request.resource.data.numeroSerie <= 200
        && request.resource.data.pesoUsado is number && request.resource.data.pesoUsado >= 0 && request.resource.data.pesoUsado <= 1000
        && request.resource.data.repsHechas is number && request.resource.data.repsHechas >= 0 && request.resource.data.repsHechas <= 1000
        && request.resource.data.nota is string && request.resource.data.nota.size() <= 500;
    }

    match /ejerciciosCatalogo/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
